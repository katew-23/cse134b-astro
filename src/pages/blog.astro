---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "My Astro Blogs";

const posts = [
    {
        slug: "/posts/post-1/",
        title: "Post 1: Getting Started with Astro",
        date: "November 16, 2025",
        description: "My first impressions of Astro and how I set up this project.",
    },
    {
        slug: "/posts/post-2/",
        title: "Post 2: Working with Layouts",
        date: "November 16, 2025",
        description: "Experimenting with BaseLayout and making pages feel consistent.",
    },
    {
        slug: "/posts/post-3/",
        title: "Post 3: Building a Simple Blog",
        date: "November 17, 2025",
        description: "Turning this site into a basic blog for my CSE 134B homework.",
    },
];
---
<BaseLayout pageTitle={pageTitle}>
  	<section class="blog-intro">
        <p>
        Welcome to my little Astro blog! This is where I'm documenting my journey
        learning Astro and building out my CSE 134B homework site.
        </p>
        <p>
        As I work through each part of the assignment, I'll add more posts here
        about what I learned, what broke, and how I fixed it.
        </p>
    </section>

    <section class="blog-list">
        <h2>Latest Posts</h2>
        <ul class="post-list">
        {posts.map((post) => (
            <li class="post-card">
                <a href={post.slug} class="post-title">{post.title}</a>
                <p class="post-meta">{post.date}</p>
                <p class="post-description">{post.description}</p>
            </li>
        ))}
        </ul>
    </section>

    <style>
        .blog-intro {
            margin-bottom: 2rem;
            color: #334155;
        }

        .blog-intro p {
            margin-bottom: 0.75rem;
        }

        .blog-list h2 {
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .post-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .post-card {
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            border-radius: 0.5rem;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
        }

        .post-title {
            display: inline-block;
            font-size: 1.15rem;
            font-weight: 700;
            text-decoration: none;
            color: #0d0950;
            margin-bottom: 0.25rem;
        }

        .post-title:hover,
        .post-title:focus {
            text-decoration: underline;
        }

        .post-meta {
            margin: 0 0 0.5rem;
            font-size: 0.9rem;
            color: #64748b;
        }

        .post-description {
            margin: 0 0 0.75rem;
            color: #1f2933;
        }

        .post-read-more {
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            color: #0d0950;
        }

        .post-read-more:hover,
        .post-read-more:focus {
            text-decoration: underline;
        }
    </style>
</BaseLayout>