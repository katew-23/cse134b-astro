---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Me";

const identity = {
    fullName: "Kate Wang",
    university: "UC San Diego",
    major: "Computer Science",
    year: "Fourth-year",
    hometown: "Indonesia",
    currentCity: "San Diego, CA",
    hobbies: ["Ultimate Frisbee", "Building apps", "Music"],
};

const skills = [
    "HTML", 
    "CSS", 
    "JavaScript",
    "Astro",
    "React",
    "C++",
    "Python",
    "Software Engineering"
];

const skillColor = "#7C3AED";   
const fontWeight = "600";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
  	<style is:global define:vars={{skillColor, fontWeight, textCase}}>
        h1 {
            color: purple;
            font-size: 4rem;
        }

        .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
    </style>

    <p>
        Hi! I'm <strong>{identity.fullName}</strong>, a {identity.year} 
        <strong>{identity.major}</strong> student at {identity.university}.  
        I'm originally from <strong>{identity.hometown}</strong> and I’m now based in 
        <strong>{identity.currentCity}</strong>.
    </p>

    <p>
        I love working on software projects, learning new web technologies, 
        and exploring UI/UX design. When I'm not coding, you’ll probably find  
        me at Ultimate Frisbee practice, playing music, or trying a new local cafe.
    </p>

    <h3>Some Facts About Me</h3>
    <ul>
        <li>My name is {identity.fullName}.</li>
        <li>I study {identity.major} at {identity.university}.</li>
        <li>I grew up in {identity.hometown}.</li>
        {identity.hobbies.length >= 2 && (
            <li>
            Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}.
            </li>
        )}
    </ul>

    <h3>My Skills</h3>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
    
</BaseLayout>